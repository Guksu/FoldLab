{
  "name": "foldlab",
  "version": "0.1.0",
  "private": true,
  "description": "폴더블·플립·듀얼 스크린 기기에서 웹사이트를 자세별로 렌더링하고 화면 문제를 찾아 주는 디버거",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build && node scripts/build-server.mjs",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "browsers": "playwright install chromium",
    "smoke": "tsx scripts/smoke.ts",
    "record:demo": "tsx scripts/record-demo.ts"
  },
  "dependencies": {
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "playwright": "^1.63.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "lucide-react": "^1.52.0",
    "pretendard": "^1.3.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "uqr": "^0.1.3",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  }
}
